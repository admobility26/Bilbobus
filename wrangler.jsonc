{
  "name": "bilbobus-aula",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application"},
  "d1_databases": [{"binding": "DB", "database_name": "bilbobus-users", "database_id": "00000000-0000-0000-0000-000000000000"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "bilbobus-private-media"}]
}
