{
  "name": "bilbobus",
  "main": "server/worker.js",
  "build": {
    "command": "npm run build"
  },
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bilbobus-users",
      "database_id": "65749d4a-610f-4b75-b443-d486e2c0d61e"
    }
  ]
}
